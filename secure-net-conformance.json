  "features": {
    "cvp.federation": 2,
    "cvp.sealed-relay": 1,
    "cvp.pq-signatures": 1,
    "cvp.identity": 2,
    "cvp.sessions": 2,
    "cvp.actors": 1,
    "cvp.activities": 1,
    "cvp.delivery": 2,
    "cvp.groups": 1,
    "cvp.repos": 1,
    "cvp.lexicons": 1,
    "cvp.envelope": 1,
    "cvp.commons-ledger": 1,
    "cvp.governance": 1,
    "cvp.tokens": 1,
    "cvp.personas": 1,
    "cvp.consent": 1,
    "cvp.extensions": 1
  },
  "deviations": [],
  "tested": {
    "how": "cargo test (Rust tests and every vector file in spec/vectors); cargo test --target wasm32-unknown-unknown -p secure-net-wasm (the WebAssembly build under Node.js); cargo run -p secure-net-tools -- standards; cargo run --example two_party, social and groups. CVP-001, 003, 004, 005, 008 and 014 have no part document yet, so for those the reference code is the definition (CVP-010, section 5). Until 0.7.0 this Rust implementation was checked message by message against the former JavaScript reference implementation; its groups interoperate with ts-mls. No implementation by another team has interoperated with it yet."
  },
  "contact": "https://github.com/Comutability/secure-net/issues"
}
