{
  "name": "@comutability/secure-net",
  "version": "0.7.0",
  "description": "Secure Net: the Commonveil Protocol. Private, end-to-end encrypted, federated communication that any app or site can use. Written in Rust; this package is its WebAssembly build.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Comutability/secure-net"
  },
  "exports": {
    ".": {
      "node": "./pkg/node/secure_net_wasm.js",
      "default": "./pkg/web/secure_net_wasm.js"
    },
    "./web": "./pkg/web/secure_net_wasm.js",
    "./node": "./pkg/node/secure_net_wasm.js",
    "./package.json": "./package.json"
  },
  "files": [
    "pkg",
    "spec",
    "secure-net-conformance.json",
    "README.md",
    "LICENSE",
    "GOVERNANCE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "cargo run --manifest-path rust/Cargo.toml -p secure-net-tools -- package",
    "prepack": "npm run build",
    "test": "cargo test --manifest-path rust/Cargo.toml",
    "standards": "cargo run --manifest-path rust/Cargo.toml -p secure-net-tools -- standards",
    "manifest": "cargo run --manifest-path rust/Cargo.toml -p secure-net-tools -- manifest"
  }
}
